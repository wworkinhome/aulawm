{
  "$comment": "AulaWM design tokens. Extraídos del prototipo LMS Wilmer Mosquera.dc.html",
  "color": {
    "ground": "#141210",
    "groundDeep": "#0E0C0B",
    "panel": "#1C1A17",
    "panel2": "#211E1B",
    "panel3": "#151312",
    "ink": "#F5F2EC",
    "accent": "#7C5CFF",
    "lime": "#C6FF3D",
    "limeHover": "#D6FF6B",
    "warn": "#FF6B4A",
    "warnText": "#FF8465",
    "inkAlpha": {
      "meta": "rgba(245,242,236,0.66)",
      "metaStrong": "rgba(245,242,236,0.70)",
      "body": "rgba(245,242,236,0.78)",
      "bodyStrong": "rgba(245,242,236,0.86)",
      "borderPanel": "rgba(245,242,236,0.09)",
      "borderField": "rgba(245,242,236,0.12)",
      "borderGhost": "rgba(245,242,236,0.16)",
      "fillSoft": "rgba(245,242,236,0.04)",
      "fillField": "rgba(245,242,236,0.05)",
      "fillHover": "rgba(245,242,236,0.08)",
      "trackEmpty": "rgba(245,242,236,0.14)"
    },
    "office": {
      "excel": "#1D6F42",
      "word": "#2B579A",
      "powerpoint": "#B7472A",
      "paper": "#F7F5F1",
      "ribbon": "#EDEAE4",
      "border": "#D6D2C9",
      "ink": "#1B1A17",
      "uiGray": "#6E6960",
      "cellOk": "#E7F3EC",
      "cellOkStrong": "#CFE8D8",
      "cellOkInk": "#12472A",
      "cellError": "#F8D7D3",
      "cellErrorInk": "#8E2118",
      "highlight": "#FFF3B0",
      "highlightRule": "#E8C200"
    },
    "syntax": {
      "keyword": "#7C5CFF",
      "identifier": "#C6FF3D",
      "tag": "#FF9E6B",
      "string": "#8AE9C1",
      "lineNumber": "rgba(245,242,236,0.40)",
      "activeLine": "rgba(124,92,255,0.12)"
    }
  },
  "font": {
    "sans": "Archivo, system-ui, sans-serif",
    "mono": "'Azeret Mono', monospace",
    "weights": [400, 500, 600, 700, 800, 900]
  },
  "type": {
    "display":      { "font": "sans", "weight": 900, "size": "clamp(34px,4.6vw,58px)", "lineHeight": 1,    "tracking": "-0.045em" },
    "numeralHero":  { "font": "sans", "weight": 900, "size": "76px",   "lineHeight": 0.85, "tracking": "-0.05em" },
    "h1":           { "font": "sans", "weight": 800, "size": "34px",   "lineHeight": 1.05, "tracking": "-0.03em" },
    "h1Sub":        { "font": "sans", "weight": 800, "size": "29px",   "lineHeight": 1.05, "tracking": "-0.03em" },
    "h2":           { "font": "sans", "weight": 700, "size": "17.5px", "lineHeight": 1.2,  "tracking": "-0.01em" },
    "h3":           { "font": "sans", "weight": 700, "size": "15px",   "lineHeight": 1.2 },
    "body":         { "font": "sans", "weight": 400, "size": "13px",   "lineHeight": 1.65 },
    "bodyRead":     { "font": "sans", "weight": 400, "size": "13.5px", "lineHeight": 1.68 },
    "label":        { "font": "sans", "weight": 600, "size": "12.5px", "lineHeight": 1.35 },
    "eyebrow":      { "font": "mono", "weight": 600, "size": "9.5px",  "lineHeight": 1, "tracking": "0.16em", "transform": "uppercase" },
    "data":         { "font": "mono", "weight": 600, "size": "11px",   "lineHeight": 1 },
    "code":         { "font": "mono", "weight": 400, "size": "13px",   "lineHeight": 1.85 }
  },
  "space": [4, 6, 7, 8, 9, 11, 12, 14, 16, 18, 20, 22, 24, 26],
  "radius": {
    "badge": 6,
    "cell": 7,
    "control": 10,
    "row": 11,
    "card": 14,
    "panel": 16,
    "header": 18,
    "chip": 20,
    "avatar": 24,
    "full": "50%"
  },
  "shadow": {
    "logo": "0 6px 22px rgba(124,92,255,0.45)",
    "slide": "0 10px 30px rgba(0,0,0,0.25)"
  },
  "motion": {
    "switch": "160ms",
    "accordion": "180ms",
    "caretBlink": "1.1s step-end infinite"
  },
  "layout": {
    "topbarHeight": 63,
    "railWidth": 214,
    "contentPadding": "26px 28px 60px",
    "authFormMaxWidth": 404,
    "gridMin": { "kpi": 190, "card": 260, "panel": 290, "resource": 232, "badge": 112, "questionCell": 30 }
  },
  "a11y": {
    "minContrastBody": 4.5,
    "minContrastHeadline": 3.0,
    "note": "Las opacidades de tinta se fijaron en 0.66+ para que la tipografía de 9–12px cumpla 4.5:1 sobre #1C1A17 y #141210."
  }
}
