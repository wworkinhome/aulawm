# Copy to .env.local for local development. Never commit the real file
# (already gitignored) — see SECURITY.md §7 Secrets & configuration.

NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_...) from Project Settings > API Keys —
# safe to expose in the browser; RLS is what actually restricts what it can
# read. See docs/adr/0008-hybrid-data-access.md.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001
