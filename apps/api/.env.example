# Copy to .env for local development. Never commit the real .env file
# (already gitignored) — see SECURITY.md §7 Secrets & configuration.

# JwtSupabaseGuard derives the JWKS verification endpoint from this —
# no separate JWT secret is needed (see docs/adr/0009-supabase-auth.md:
# this project uses asymmetric JWT Signing Keys, not the legacy HS256
# shared secret).
SUPABASE_URL=
# "Secret key" (sb_secret_...) from Project Settings > API Keys — the new
# key naming, not the legacy service_role key. Bypasses RLS; server-side only.
SUPABASE_SECRET_KEY=

# Direct Postgres connection, used for raw SQL migrations (see
# docs/adr/0012-raw-sql-migrations.md) — not an ORM connection string.
DATABASE_URL=

JUDGE0_URL=
JUDGE0_TOKEN=

# Video provider — see docs/adr/0011-video-hosting.md. Unused in Phase 1
# (YouTube-link bridge); required starting Phase 4.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

SMTP_URL=
DOMINIO_INSTITUCIONAL=colegio.edu.co
